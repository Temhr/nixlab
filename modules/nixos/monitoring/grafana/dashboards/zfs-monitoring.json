{
  "id": null,
  "uid": "zfs-pool-monitoring",
  "title": "ZFS Pool Monitoring",
  "tags": [
    "zfs",
    "storage",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "editable": true,
  "version": 4,
  "refresh": "30s",
  "style": "dark",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "zpool",
        "type": "query",
        "label": "ZFS Pool",
        "datasource": null,
        "query": "label_values(node_zfs_zpool_state, zpool)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "🏊 Pool State",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pool State",
      "description": "The pool's current state. Anything other than 'online' needs attention (degraded = redundancy lost, faulted or suspended = pool unavailable or I/O halted). Note: ZFS only changes state when I/O reaches a failed disk, so also check 'Member Disks' below.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "node_zfs_zpool_state{zpool=~\"$zpool\"} == 1",
          "legendFormat": "{{zpool}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*degraded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(faulted|unavail|offline|removed|suspended)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pool State History",
      "description": "1 = pool was in this state. Online should stay at 1 and the others at 0. Watch for degraded, faulted or suspended spikes.",
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "node_zfs_zpool_state{zpool=~\"$zpool\", state=\"online\"}",
          "legendFormat": "online {{zpool}}"
        },
        {
          "expr": "node_zfs_zpool_state{zpool=~\"$zpool\", state=\"degraded\"}",
          "legendFormat": "degraded {{zpool}}"
        },
        {
          "expr": "node_zfs_zpool_state{zpool=~\"$zpool\", state=\"faulted\"}",
          "legendFormat": "faulted {{zpool}}"
        },
        {
          "expr": "node_zfs_zpool_state{zpool=~\"$zpool\", state=\"suspended\"}",
          "legendFormat": "suspended {{zpool}}"
        },
        {
          "expr": "node_zfs_zpool_state{zpool=~\"$zpool\", state=\"offline\"}",
          "legendFormat": "offline {{zpool}}"
        },
        {
          "expr": "node_zfs_zpool_state{zpool=~\"$zpool\", state=\"removed\"}",
          "legendFormat": "removed {{zpool}}"
        },
        {
          "expr": "node_zfs_zpool_state{zpool=~\"$zpool\", state=\"unavail\"}",
          "legendFormat": "unavail {{zpool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "axisLabel": "State (1 = active)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "online.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "degraded.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(faulted|suspended|offline|removed|unavail).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 27,
      "type": "row",
      "title": "💽 Member Disks & Integrity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 28,
      "type": "stat",
      "title": "Missing Disks",
      "description": "Configured pool disks whose /dev/disk/by-id path no longer exists (OS view, updated every 30s). Independent of what ZFS reports.",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(zfs_expected_device_present{pool=~\"$zpool\"} == 0) or vector(0)",
          "legendFormat": "Missing Disks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 29,
      "type": "stat",
      "title": "Not Online in ZFS",
      "description": "Configured disks that 'zpool status' does not list as ONLINE. May lag behind 'Missing Disks' on an idle pool, because ZFS only notices a failed disk when I/O reaches it.",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(zfs_expected_device_online{pool=~\"$zpool\"} == 0) or vector(0)",
          "legendFormat": "Not Online in ZFS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Auto-Onlined (1h)",
      "description": "Disks that came back and were automatically re-onlined by zfs-member-reconcile in the last hour. A disk that keeps showing up here is flaky.",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "count((time() - zfs_device_last_auto_online_timestamp_seconds{pool=~\"$zpool\"} < 3600) and (zfs_device_last_auto_online_timestamp_seconds{pool=~\"$zpool\"} > 0)) or vector(0)",
          "legendFormat": "Auto-Onlined (1h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Disk Errors",
      "description": "Sum of read, write and checksum errors across member disks. Counters stay until 'zpool clear'.",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(zfs_vdev_errors{pool=~\"$zpool\", vdev_type=\"disk\"}) or vector(0)",
          "legendFormat": "Disk Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Pool Data Errors",
      "description": "Permanent data errors ZFS could not repair. Run 'zpool status -v' to list the affected files.",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(zfs_pool_error_count{pool=~\"$zpool\"}) or vector(0)",
          "legendFormat": "Pool Data Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Last Scrub Age",
      "description": "Time since the last completed scrub. Weekly autoScrub is expected; yellow after 8 days, red after 10 (the ZpoolScrubOverdue threshold).",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "targets": [
        {
          "expr": "max(time() - zfs_last_scrub_end_timestamp_seconds{pool=~\"$zpool\"})",
          "legendFormat": "Last Scrub Age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 691200,
                "color": "yellow"
              },
              {
                "value": 864000,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Last Scrub Errors",
      "description": "Unrepaired errors found by the last completed scrub. Stays until the next clean scrub finishes.",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(zfs_last_scrub_errors{pool=~\"$zpool\"}) or vector(0)",
          "legendFormat": "Last Scrub Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 35,
      "type": "stat",
      "title": "Firing ZFS Alerts",
      "description": "Number of currently firing alerts whose name starts with Zpool.",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"Zpool.*\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Firing ZFS Alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 36,
      "type": "state-timeline",
      "title": "Disk Presence (what the OS sees)",
      "description": "One row per configured disk. Turns red the moment the disk's by-id path disappears (checked every 30s). Compare with the panel on the right: any gap between the two is ZFS not yet having noticed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "zfs_expected_device_present{pool=~\"$zpool\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "MISSING",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "present",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 37,
      "type": "state-timeline",
      "title": "Disk State in ZFS (what ZFS reports)",
      "description": "One row per configured disk: green when 'zpool status' lists it ONLINE, orange otherwise (OFFLINE, REMOVED, UNAVAIL, FAULTED). Lags the left panel when the pool is idle.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "zfs_expected_device_online{pool=~\"$zpool\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT ONLINE",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "online",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 38,
      "type": "timeseries",
      "title": "Errors per Vdev (read + write + checksum)",
      "description": "Current error counters from 'zpool status', summed per vdev. Disks should stay at 0. A step up that never returns to 0 means the counters have not been cleared ('zpool clear').",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (device) (zfs_vdev_errors{pool=~\"$zpool\"})",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "axisLabel": "Errors"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 39,
      "type": "timeseries",
      "title": "Days Since Last Completed Scrub",
      "description": "Sawtooth: resets to 0 whenever a scrub finishes. The red line is the 10-day ZpoolScrubOverdue threshold.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "(time() - zfs_last_scrub_end_timestamp_seconds{pool=~\"$zpool\"}) / 86400",
          "legendFormat": "{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "decimals": 1,
          "custom": {
            "axisLabel": "Days",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "📁 Dataset I/O",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dataset IOPS",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "expr": "rate(node_zfs_zpool_dataset_reads{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Reads {{dataset}}"
        },
        {
          "expr": "rate(node_zfs_zpool_dataset_writes{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Writes {{dataset}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "custom": {
            "axisLabel": "I/O operations per second"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Read and write operations per second for each dataset in the selected pool(s), 5 minute average. Shows which datasets generate the I/O."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dataset Bandwidth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "expr": "rate(node_zfs_zpool_dataset_nread{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Read {{dataset}}"
        },
        {
          "expr": "rate(node_zfs_zpool_dataset_nwritten{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Write {{dataset}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "axisLabel": "Throughput"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Bytes read and written per second for each dataset in the selected pool(s), 5 minute average."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dataset File Activity (links/unlinks)",
      "description": "nunlinks = file deletes requested, nunlinked = deletes completed. A persistent gap between the two may mean delete processing is lagging.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "expr": "rate(node_zfs_zpool_dataset_nunlinks{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Unlinks/s {{dataset}}"
        },
        {
          "expr": "rate(node_zfs_zpool_dataset_nunlinked{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Unlinked/s {{dataset}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisLabel": "File operations per second"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Dataset ZIL Commit Rate",
      "description": "ZIL commits per dataset, plus stalls and errors. High commit counts with stalls indicate sync write pressure; any errors need investigating.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "expr": "rate(node_zfs_zpool_dataset_zil_commit_count{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Commits/s {{dataset}}"
        },
        {
          "expr": "rate(node_zfs_zpool_dataset_zil_commit_stall_count{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Stalls/s {{dataset}}"
        },
        {
          "expr": "rate(node_zfs_zpool_dataset_zil_commit_error_count{zpool=~\"$zpool\"}[5m])",
          "legendFormat": "Errors/s {{dataset}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisLabel": "Events per second"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "🧠 ARC (Adaptive Replacement Cache)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "ARC Size",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "expr": "node_zfs_arc_size",
          "legendFormat": "ARC Size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Current size of the ARC, ZFS's in-RAM read cache. Normally grows to fill available RAM up to ARC Max and shrinks under memory pressure."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "ARC Max",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 46
      },
      "targets": [
        {
          "expr": "node_zfs_arc_c_max",
          "legendFormat": "ARC Max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Upper limit for ARC size (c_max). Defaults scale with RAM and can be changed with the zfs_arc_max module parameter."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "ARC Min",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 8,
        "y": 46
      },
      "targets": [
        {
          "expr": "node_zfs_arc_c_min",
          "legendFormat": "ARC Min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Lower limit the ARC will shrink to under memory pressure (c_min)."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "ARC Target",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 12,
        "y": 46
      },
      "targets": [
        {
          "expr": "node_zfs_arc_c",
          "legendFormat": "ARC Target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "The size ARC is currently aiming for (c). It adapts up and down with demand and memory pressure; actual size converges toward it."
    },
    {
      "id": 14,
      "type": "stat",
      "title": "ARC Data",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 46
      },
      "targets": [
        {
          "expr": "node_zfs_arc_data_size",
          "legendFormat": "ARC Data"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Portion of the ARC holding cached file data."
    },
    {
      "id": 15,
      "type": "stat",
      "title": "ARC Metadata",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 46
      },
      "targets": [
        {
          "expr": "node_zfs_arc_metadata_size",
          "legendFormat": "ARC Metadata"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Portion of the ARC holding metadata such as directory entries and block pointers."
    },
    {
      "id": 16,
      "type": "gauge",
      "title": "ARC Hit Ratio",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "expr": "rate(node_zfs_arc_hits[5m]) / (rate(node_zfs_arc_hits[5m]) + rate(node_zfs_arc_misses[5m])) * 100",
          "legendFormat": "Hit %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 70,
                "color": "yellow"
              },
              {
                "value": 90,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdMarkers": true
      },
      "description": "Percent of cache lookups served from RAM instead of disk, over 5 minutes. 90%+ is typical for steady workloads. A low value can mean the working set is larger than the ARC, or a one-off large scan, so judge it over time."
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "ARC Hits vs Misses",
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 4,
        "y": 49
      },
      "targets": [
        {
          "expr": "rate(node_zfs_arc_hits[5m])",
          "legendFormat": "Total Hits"
        },
        {
          "expr": "rate(node_zfs_arc_misses[5m])",
          "legendFormat": "Total Misses"
        },
        {
          "expr": "rate(node_zfs_arc_demand_data_hits[5m])",
          "legendFormat": "Demand Data Hits"
        },
        {
          "expr": "rate(node_zfs_arc_demand_metadata_hits[5m])",
          "legendFormat": "Demand Metadata Hits"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisLabel": "Cache lookups per second"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Cache lookups per second: total hits and misses, plus demand data and metadata hits. Misses go to disk; rising misses with falling hits suggest the working set no longer fits in the ARC."
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "ARC MRU / MFU Size",
      "description": "MRU = Most Recently Used, MFU = Most Frequently Used. Healthy ARC balances both. Ghost lists track recently evicted entries; hits on them tell ZFS which side to grow.",
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 14,
        "y": 49
      },
      "targets": [
        {
          "expr": "node_zfs_arc_mru_size",
          "legendFormat": "MRU"
        },
        {
          "expr": "node_zfs_arc_mfu_size",
          "legendFormat": "MFU"
        },
        {
          "expr": "node_zfs_arc_mru_ghost_size",
          "legendFormat": "MRU Ghost"
        },
        {
          "expr": "node_zfs_arc_mfu_ghost_size",
          "legendFormat": "MFU Ghost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "axisLabel": "Cache size"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "ARC Size Over Time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "expr": "node_zfs_arc_size",
          "legendFormat": "Total"
        },
        {
          "expr": "node_zfs_arc_c_max",
          "legendFormat": "Max (c_max)"
        },
        {
          "expr": "node_zfs_arc_c_min",
          "legendFormat": "Min (c_min)"
        },
        {
          "expr": "node_zfs_arc_c",
          "legendFormat": "Target (c)"
        },
        {
          "expr": "node_zfs_arc_data_size",
          "legendFormat": "Data"
        },
        {
          "expr": "node_zfs_arc_metadata_size",
          "legendFormat": "Metadata"
        },
        {
          "expr": "node_zfs_arc_anon_size",
          "legendFormat": "Anon"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "axisLabel": "Cache size"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Total ARC size compared with its target (c) and the min/max limits, plus the data, metadata and anonymous (dirty, not yet written) portions."
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Prefetch Hits vs Misses",
      "description": "High prefetch miss rate means the prefetcher is not predicting access patterns well. Predictive and prescient hits are demand reads that were satisfied by earlier prefetching.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 54
      },
      "targets": [
        {
          "expr": "rate(node_zfs_arc_prefetch_data_hits[5m])",
          "legendFormat": "Data Hits"
        },
        {
          "expr": "rate(node_zfs_arc_prefetch_data_misses[5m])",
          "legendFormat": "Data Misses"
        },
        {
          "expr": "rate(node_zfs_arc_prefetch_metadata_hits[5m])",
          "legendFormat": "Metadata Hits"
        },
        {
          "expr": "rate(node_zfs_arc_prefetch_metadata_misses[5m])",
          "legendFormat": "Metadata Misses"
        },
        {
          "expr": "rate(node_zfs_arc_demand_hit_predictive_prefetch[5m])",
          "legendFormat": "Predictive Hits"
        },
        {
          "expr": "rate(node_zfs_arc_demand_hit_prescient_prefetch[5m])",
          "legendFormat": "Prescient Hits"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisLabel": "Cache lookups per second"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "📝 ZIL (ZFS Intent Log)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 62
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "ZIL Commit Activity",
      "description": "commit_count = sync writes committed. stall = waiting on ZIL. suspend = ZIL suspended (serious). Errors should always be zero.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 63
      },
      "targets": [
        {
          "expr": "rate(node_zfs_zil_zil_commit_count[5m])",
          "legendFormat": "Commits/s"
        },
        {
          "expr": "rate(node_zfs_zil_zil_commit_writer_count[5m])",
          "legendFormat": "Writers/s"
        },
        {
          "expr": "rate(node_zfs_zil_zil_commit_stall_count[5m])",
          "legendFormat": "Stalls/s"
        },
        {
          "expr": "rate(node_zfs_zil_zil_commit_suspend_count[5m])",
          "legendFormat": "Suspends/s"
        },
        {
          "expr": "rate(node_zfs_zil_zil_commit_error_count[5m])",
          "legendFormat": "Errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisLabel": "Events per second"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "ZIL Transaction Bytes",
      "description": "itx_copied = small writes copied into the ZIL. itx_needcopy = larger writes. itx_indirect = indirect writes. The metaslab lines show where ZIL blocks are allocated (normal pool vs SLOG device).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 63
      },
      "targets": [
        {
          "expr": "rate(node_zfs_zil_zil_itx_copied_bytes[5m])",
          "legendFormat": "Copied Bytes/s"
        },
        {
          "expr": "rate(node_zfs_zil_zil_itx_needcopy_bytes[5m])",
          "legendFormat": "Needcopy Bytes/s"
        },
        {
          "expr": "rate(node_zfs_zil_zil_itx_indirect_bytes[5m])",
          "legendFormat": "Indirect Bytes/s"
        },
        {
          "expr": "rate(node_zfs_zil_zil_itx_metaslab_normal_bytes[5m])",
          "legendFormat": "Metaslab Normal Bytes/s"
        },
        {
          "expr": "rate(node_zfs_zil_zil_itx_metaslab_slog_bytes[5m])",
          "legendFormat": "Metaslab SLOG Bytes/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "axisLabel": "Throughput"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 24,
      "type": "row",
      "title": "💾 Disk Space (mounted datasets)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 71
      }
    },
    {
      "id": 25,
      "type": "gauge",
      "title": "ZFS Dataset Space Used %",
      "description": "Space usage per mounted ZFS dataset via node_filesystem metrics.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 72
      },
      "targets": [
        {
          "expr": "100 * (node_filesystem_size_bytes{fstype=\"zfs\"} - node_filesystem_avail_bytes{fstype=\"zfs\"}) / node_filesystem_size_bytes{fstype=\"zfs\"}",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 70,
                "color": "yellow"
              },
              {
                "value": 85,
                "color": "orange"
              },
              {
                "value": 95,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "ZFS Dataset Free Space Over Time",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 72
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype=\"zfs\"}",
          "legendFormat": "Free {{mountpoint}}"
        },
        {
          "expr": "node_filesystem_size_bytes{fstype=\"zfs\"}",
          "legendFormat": "Total {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "axisLabel": "Space"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Free (available) and total bytes for each mounted ZFS dataset. Falling free space with a flat total means it is filling up. Datasets in the same pool share that pool's free space unless they have quotas."
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "ZFS alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": null,
        "expr": "ALERTS{alertname=~\"Zpool.*\", alertstate=\"firing\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{device}}{{pool}}{{zpool}}"
      }
    ]
  }
}
