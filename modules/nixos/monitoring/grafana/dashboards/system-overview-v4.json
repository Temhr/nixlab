        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "expr": "ALERTS{alertstate=\"firing\", instance=~\"$instance\"}",
        "titleFormat": "{{alertname}} ({{instance}})",
        "textFormat": "{{severity}}: {{condition}}",
        "tagKeys": "severity,category",
        "step": "60s"
      }
    ]
  }
}